# ─── CloudShield Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Backend Core ───────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string-minimum
FERNET_KEY=change-me-generate-with-python-cryptography-fernet

# ─── Admin Seed Account ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@cloudshield.local
ADMIN_PASSWORD=Admin@12345!

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cloudshield.db
# For Postgres (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cloudshield

# ─── CORS ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Log Monitor ────────────────────────────────────────────────────────────
LOG_POLL_INTERVAL_SECONDS=30

# ─── Demo Mode ──────────────────────────────────────────────────────────────
DEMO_EVENT_INTERVAL_MIN=3
DEMO_EVENT_INTERVAL_MAX=8

# ─── Reports ────────────────────────────────────────────────────────────────
REPORT_TOOL_VERSION=1.0.0

# ─── Risk Scoring Defaults ──────────────────────────────────────────────────
DEFAULT_DATA_SENSITIVITY=3
RISK_BAND_CRITICAL_MIN=91
RISK_BAND_HIGH_MIN=51
RISK_BAND_MEDIUM_MIN=21
